{
  "name": "railway-monitoring-platform",
  "version": "1.0.0",
  "description": "Centralized Monitoring Platform for Railway Signaling Equipment, Maintenance, Fault Reporting & Compliance",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "server": "cd backend && npm start",
    "client": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "seed": "cd backend && npm run seed",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install-all": "npm run install:backend && npm run install:frontend"
  },
  "keywords": [
    "railway",
    "signaling",
    "monitoring",
    "mern",
    "react",
    "mongodb",
    "express",
    "node"
  ],
  "author": "College Final Year Project Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "express": "^5.3.0",
    "vite": "^8.3.5"
  }
}
